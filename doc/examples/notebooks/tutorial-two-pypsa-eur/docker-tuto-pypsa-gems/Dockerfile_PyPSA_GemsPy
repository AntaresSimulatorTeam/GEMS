FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.pixi/bin:$PATH"

RUN apt-get update && apt-get install -y \
    curl \
    tar \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install pixi
RUN curl -fsSL https://pixi.sh/install.sh | bash

RUN pip install --no-cache-dir --no-input \
    jupyter \
    matplotlib \
    netcdf4 \
    xarray \
    pypsa \
    pypsa-to-gems-converter \
    gemspy==0.1.3

WORKDIR /workspace

# Build context is tutorial-two-pypsa-eur/
COPY pypsa-eur/ /workspace/pypsa-eur/
COPY tutorial_pypsa_eur_gemspy.ipynb /workspace/tutorial_pypsa_eur_gemspy.ipynb

EXPOSE 9988

CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=9988", "--no-browser", "--IdentityProvider.token=", "--LabApp.extension_manager=readonly", "--allow-root"]
